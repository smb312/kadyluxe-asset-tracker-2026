# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real keys.

# --- Supabase project (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Team allowlist (app-level gate) ---
# Comma-separated emails allowed to sign in. Only these addresses receive a
# magic link and can hold a session. Keep this in sync with the allowlist
# table seeded by supabase/rls_and_auth.sql.
ALLOWED_EMAILS=eric@growwithcoast.com,scott@growwithcoast.com,kady@kadyluxe.com

# --- Where magic-link emails redirect back to ---
# Local dev: http://localhost:3000 . Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
